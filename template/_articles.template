<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/github.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
    <title>{{ content.title }}</title>
<style>

:root {
    --serif-font: 'Source Serif 4', Georgia, 'Times New Roman', serif;
    --sans-font: 'IBM Plex Sans', -apple-system, sans-serif;
    --mono-font: 'IBM Plex Mono', 'Fira Code', Consolas, monospace;

    --paper-bg: #f6f3ec;
    --ink: #201c16;
    --ink-muted: #6b6255;
    --rule: #dcd4c2;
    --accent: #2c4a7c;
    --accent-soft: rgba(44, 74, 124, 0.08);
    --code-bg: #efece2;
}

@media (prefers-color-scheme: dark) {
    :root {
        --paper-bg: #16140f;
        --ink: #e9e4d8;
        --ink-muted: #a89d89;
        --rule: #3a3527;
        --accent: #8fb2e8;
        --accent-soft: rgba(143, 178, 232, 0.1);
        --code-bg: #201c16;
    }
}

* {
    box-sizing: border-box;
}

body {
    background-color: var(--paper-bg);
    color: var(--ink);
    font-family: var(--sans-font);
    margin: 0;
    padding: 0;
}

img {
    max-width: 100%;
    height: auto;
}

.topbar {
    padding: 1.5rem 2rem;
}

.home-link {
    font-family: var(--sans-font);
    font-size: 0.85rem;
    color: var(--ink-muted);
    text-decoration: none;
}

.home-link:hover {
    color: var(--accent);
}

.paper {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
}

.paper-head {
    text-align: center;
    padding-bottom: 2rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
}

.kicker {
    font-family: var(--sans-font);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
}

.paper-head h1 {
    font-family: var(--serif-font);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.2;
    margin: 0 0 1rem;
    color: var(--ink);
}

.byline {
    font-family: var(--sans-font);
    font-size: 0.85rem;
    letter-spacing: 0.01em;
    color: var(--ink-muted);
    margin: 0;
}

.paper-body {
    font-family: var(--serif-font);
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--ink);
    text-align: justify;
    hyphens: auto;
    counter-reset: section;
}

.paper-body p {
    margin: 0 0 1.4em;
}

.paper-body h2 {
    counter-increment: section;
    counter-reset: subsection;
    font-family: var(--sans-font);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    margin: 2.5em 0 1em;
    padding-left: 0.75em;
    border-left: 3px solid var(--accent);
    text-align: left;
}

.paper-body h2::before {
    content: counter(section) ". ";
    color: var(--accent);
}

.paper-body h3 {
    counter-increment: subsection;
    font-family: var(--sans-font);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 2em 0 0.75em;
    text-align: left;
}

.paper-body h3::before {
    content: counter(section) "." counter(subsection) " ";
    color: var(--accent);
}

.paper-body h4, .paper-body h5, .paper-body h6 {
    font-family: var(--sans-font);
    font-weight: 600;
    color: var(--ink);
    margin: 1.75em 0 0.6em;
    text-align: left;
}

.paper-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
}

.paper-body a:hover {
    background-color: var(--accent-soft);
}

.paper-body strong {
    font-weight: 700;
}

.paper-body sup {
    color: var(--accent);
    font-weight: 600;
}

.paper-body sup a {
    text-decoration: none;
}

.paper-body ul, .paper-body ol {
    margin: 0 0 1.4em;
    padding-left: 1.5em;
    text-align: left;
}

.paper-body li {
    margin-bottom: 0.4em;
}

.paper-body blockquote {
    font-family: var(--serif-font);
    font-style: italic;
    color: var(--ink-muted);
    margin: 2em 0;
    padding: 0.2em 0 0.2em 1.5em;
    border-left: 3px solid var(--rule);
    text-align: left;
}

.paper-body pre {
    background-color: var(--code-bg);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 1em;
    overflow-x: auto;
    margin: 1.5em 0;
    text-align: left;
}

.paper-body code {
    font-family: var(--mono-font);
    font-size: 0.85em;
}

.paper-body p code {
    background-color: var(--code-bg);
    padding: 0.1em 0.35em;
    border-radius: 3px;
}

.paper-body hr {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 3em 0;
}

.paper-body .references {
    margin-top: 1em;
    padding-top: 1em;
}

.paper-body .references ol {
    padding-left: 1.4em;
}

.paper-body .references li {
    font-family: var(--sans-font);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-muted);
    text-align: left;
    margin-bottom: 0.6em;
}

.footer {
    background-color: var(--paper-bg) !important;
    color: var(--ink-muted) !important;
    border-top: 1px solid var(--rule) !important;
}

.footer a {
    color: var(--accent) !important;
}

@media (max-width: 700px) {
    .paper-body {
        text-align: left;
        hyphens: none;
    }
}

@media print {
    .topbar, .footer {
        display: none;
    }
    .paper-body {
        text-align: left;
    }
}

</style>
  </head>
  <body>
    <div class="topbar">
      <a href="https://elias.sh" class="home-link">< back to home</a>
    </div>
    <main class="paper">
      <header class="paper-head">
        <p class="kicker">Article</p>
        <h1>{{ content.title }}</h1>
        <p class="byline">By {{ author }} - Published {{ date_format(content.date, '%B %-d, %Y') }}</p>
      </header>
      <article class="paper-body">
        {{ content.content }}
      </article>
    </main>
    {{ render('template/_footer.template')}}
  </body>
</html>
